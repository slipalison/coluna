{
  "name": "@slipalison/coluna",
  "version": "0.0.0",
  "description": "Design system do Basalto: tokens, tema claro e escuro, e componentes atômicos em React.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/coluna.js",
  "module": "./dist/coluna.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/coluna.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slipalison/coluna.git"
  },
  "homepage": "https://github.com/slipalison/coluna#readme",
  "bugs": {
    "url": "https://github.com/slipalison/coluna/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "keywords": [
    "design-system",
    "react",
    "design-tokens",
    "dark-mode",
    "basalto"
  ],
  "scripts": {
    "prepare": "node scripts/gerar-tokens.mjs",
    "tokens": "node scripts/gerar-tokens.mjs",
    "dev": "vite build --watch",
    "build": "npm run tokens && tsc --noEmit && vite build && node scripts/construir-css.mjs",
    "test": "npm run tokens && vitest run --coverage",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "referencia": "node scripts/gerar-referencia.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "happy-dom": "^20.14.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "style-dictionary": "^5.5.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.0"
  }
}
